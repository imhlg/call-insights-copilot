# Local Ollama model installed on this machine. Change this to another `ollama list` name as needed.
OLLAMA_MODEL=k2-hlg-local-7b
OLLAMA_BASE_URL=http://localhost:11434/v1/

# Heavy tasks are pinned to MiMo v2.6 Pro in src/common/config.py.
MIMO_API_KEY=

# Required for Token Plan keys: copy the exact OpenAI-compatible URL from your
# account page. For pay-as-you-go keys, leave blank to use the standard API URL.
MIMO_BASE_URL=

# Used when a light Ollama call is still running after 180 seconds.
# The fallback model is Claude Haiku 5.5 at low effort.
ANTHROPIC_API_KEY=
